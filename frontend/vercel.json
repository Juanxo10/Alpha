{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://geovisor-backend.onrender.com/api/:path*" },
    { "source": "/data/:path*", "destination": "https://geovisor-backend.onrender.com/data/:path*" },
    { "source": "/marca/:path*", "destination": "https://geovisor-backend.onrender.com/marca/:path*" },
    { "source": "/manifest.webmanifest", "destination": "https://geovisor-backend.onrender.com/manifest.webmanifest" }
  ]
}
